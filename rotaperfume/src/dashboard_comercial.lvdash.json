{
  "datasets": [
    {
      "config": {
        "comment": "Métricas de vendas excluindo devoluções",
        "dimensions": [
          {
            "comment": "Data em que o pedido foi realizado",
            "displayName": "Data do Pedido",
            "expr": "data_pedido",
            "format": {
              "dateFormat": "locale_short_month",
              "type": "date"
            },
            "name": "data_pedido"
          },
          {
            "comment": "Mês do pedido para análise temporal",
            "displayName": "Mês",
            "expr": "DATE_TRUNC('MONTH', data_pedido)",
            "format": {
              "dateFormat": "locale_short_month",
              "type": "date"
            },
            "name": "mes_pedido"
          },
          {
            "comment": "Canal de origem da venda",
            "displayName": "Canal de Venda",
            "expr": "canal",
            "name": "canal"
          },
          {
            "comment": "Categoria do produto vendido",
            "displayName": "Categoria",
            "expr": "categoria",
            "name": "categoria"
          },
          {
            "comment": "Marca do produto",
            "displayName": "Marca",
            "expr": "marca",
            "name": "marca"
          },
          {
            "comment": "Tipo de ponto de venda do cliente",
            "displayName": "Segmento Cliente",
            "expr": "segmento",
            "name": "segmento"
          },
          {
            "comment": "Estado do cliente",
            "displayName": "UF",
            "expr": "uf",
            "name": "uf"
          },
          {
            "comment": "Cidade do cliente",
            "displayName": "Cidade",
            "expr": "cidade",
            "name": "cidade"
          }
        ],
        "filter": "devolucao = false",
        "measures": [
          {
            "comment": "Soma da receita de vendas",
            "displayName": "Receita Total",
            "expr": "SUM(receita)",
            "format": {
              "currencyCode": "BRL",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "receita_total",
            "synonyms": [
              "faturamento",
              "vendas"
            ]
          },
          {
            "comment": "Total de unidades vendidas",
            "displayName": "Quantidade Vendida",
            "expr": "SUM(quantidade)",
            "format": {
              "decimalPlaces": {
                "places": 0,
                "type": "exact"
              },
              "type": "number"
            },
            "name": "quantidade_vendida"
          },
          {
            "comment": "Soma da margem de lucro",
            "displayName": "Margem Total",
            "expr": "SUM(margem)",
            "format": {
              "currencyCode": "BRL",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "margem_total"
          },
          {
            "comment": "Soma dos custos",
            "displayName": "Custo Total",
            "expr": "SUM(custo)",
            "format": {
              "currencyCode": "BRL",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "custo_total"
          },
          {
            "comment": "Total de pedidos distintos",
            "displayName": "Número de Pedidos",
            "expr": "COUNT(DISTINCT pedido_id)",
            "format": {
              "decimalPlaces": {
                "places": 0,
                "type": "exact"
              },
              "type": "number"
            },
            "name": "numero_pedidos"
          },
          {
            "comment": "Receita média por pedido",
            "displayName": "Ticket Médio",
            "expr": "SUM(receita) / COUNT(DISTINCT pedido_id)",
            "format": {
              "currencyCode": "BRL",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "ticket_medio"
          },
          {
            "comment": "Percentual de margem sobre receita",
            "displayName": "Margem %",
            "expr": "(SUM(margem) / SUM(receita)) * 100",
            "format": {
              "decimalPlaces": {
                "places": 1,
                "type": "exact"
              },
              "type": "percentage"
            },
            "name": "margem_percentual"
          }
        ],
        "source": "lakehouse_rotaperfume.gold.fato_vendas",
        "version": "1.1"
      },
      "displayName": "Dashboard de Vendas - Rota Perfume",
      "name": "dashboard_de_vendas_rota_perfume"
    },
    {
      "name": "fila_semanal",
      "displayName": "Fila da semana",
      "config": {
        "version": "1.1",
        "source": "lakehouse_rotaperfume.gold.fila_semanal",
        "comment": "As 200 ligacoes da semana, ja ordenadas e distribuidas por vendedor. Uma linha por contato.",
        "dimensions": [
          {
            "comment": "Vendedor responsavel pela carteira do cliente.",
            "displayName": "Vendedor",
            "expr": "vendedor",
            "name": "vendedor"
          },
          {
            "comment": "Posicao do contato dentro da fila deste vendedor.",
            "displayName": "Ordem",
            "expr": "ordem",
            "name": "ordem"
          },
          {
            "comment": "Nome da empresa cliente.",
            "displayName": "Cliente",
            "expr": "razao_social",
            "name": "razao_social"
          },
          {
            "comment": "Cidade do cliente.",
            "displayName": "Cidade",
            "expr": "cidade",
            "name": "cidade"
          },
          {
            "comment": "Estado do cliente.",
            "displayName": "UF",
            "expr": "uf",
            "name": "uf"
          },
          {
            "comment": "O score em quartis: Fria, Morna, Quente, Muito quente.",
            "displayName": "Faixa",
            "expr": "faixa",
            "name": "faixa"
          },
          {
            "comment": "Por que este cliente entrou na fila, em portugues.",
            "displayName": "Motivo",
            "expr": "motivo",
            "name": "motivo"
          },
          {
            "comment": "Produto a oferecer, com o saldo em estoque.",
            "displayName": "O que oferecer",
            "expr": "sugestao",
            "name": "sugestao"
          }
        ],
        "measures": [
          {
            "name": "contatos",
            "displayName": "Contatos",
            "expr": "COUNT(1)",
            "comment": "Quantidade de ligacoes a fazer.",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0
              }
            }
          },
          {
            "name": "vendedores",
            "displayName": "Vendedores",
            "expr": "COUNT(DISTINCT vendedor)",
            "comment": "Quantos vendedores tem ao menos um contato na fila.",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0
              }
            }
          },
          {
            "name": "score_medio",
            "displayName": "Nota media",
            "expr": "AVG(score)",
            "comment": "Probabilidade media de compra nos proximos 7 dias.",
            "format": {
              "type": "number-percent",
              "decimalPlaces": {
                "type": "exact",
                "places": 1
              }
            }
          },
          {
            "name": "ticket_medio_fila",
            "displayName": "Ticket medio",
            "expr": "AVG(ticket_medio)",
            "comment": "Ticket medio dos clientes da fila.",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2
              }
            }
          }
        ]
      }
    }
  ],
